<!-- Incluye aquí tu <head> donde llamas a tu CSS -->
<link rel="stylesheet" href="/css/estilo.css"> 

<!-- SweetAlert2 CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<main class="contenedor-principal">
    <div class="card-formulario">
        <h2>Iniciar Sesión</h2>
        <!-- Cambiado action por id para controlarlo con JS -->
        <form id="loginForm">
            <div class="campo">
                <label>Correo Electrónico</label>
                <input type="email" name="email" id="email" required>
            </div>
            
            <!-- Campo de Contraseña con Botón de Ojito -->
            <div class="campo" style="position: relative;">
                <label>Contraseña</label>
                <div style="display: flex; align-items: center;">
                    <input type="password" name="password" id="passwordLogin" required style="width: 100%;">
                    <button type="button" id="btnToggleLogin" onclick="togglePassword('passwordLogin', 'iconLogin')" style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; font-size: 1.2rem;">
                        <span id="iconLogin">🔒</span>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-azul-boca">Entrar</button>
        </form>

        <!-- Enlace para abrir el modal de recuperación -->
        <p class="text-center mt-3">
            <a href="#" onclick="abrirModalRecuperar(event)" style="font-size: 0.9rem; text-decoration: none; color: #002868;">¿Olvidaste tu contraseña?</a>
        </p>
    </div>
</main>

<!-- Modal: Recuperar Contraseña -->
<div id="modalRecuperar" class="modal-overlay" style="display: none; position: fixed; top:0; left:0; width:100%; height:100%; background: rgba(0,0,0,0.7); z-index: 2000; align-items: center; justify-content: center;">
    <div class="card-formulario" style="background: white; max-width: 400px; padding: 25px; border-radius: 10px; position: relative;">
        <h3 style="margin-bottom: 20px; font-size: 1.3rem; color: #002868;">Restablecer Contraseña</h3>
        <form id="formRecuperar">
            <div class="campo">
                <label>Correo Electrónico</label>
                <input type="email" name="email" id="emailRecuperar" required>
            </div>
            
            <!-- Campo de Nueva Contraseña con el Ojito -->
            <div class="campo" style="position: relative;">
                <label>Nueva Contraseña</label>
                <div style="display: flex; align-items: center;">
                    <input type="password" name="password" id="passwordNueva" required style="width: 100%;">
                    <button type="button" onclick="togglePassword('passwordNueva', 'iconRecuperar')" style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; font-size: 1.2rem;">
                        <span id="iconRecuperar">👁️‍🗨️</span>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-azul-boca" style="margin-top: 10px;">Actualizar Contraseña</button>
            <button type="button" class="btn btn-secondary w-100 mt-2" onclick="cerrarModalRecuperar()" style="background: #6c757d; color: white; border: none; padding: 10px; border-radius: 5px; cursor: pointer; width: 100%; margin-top: 10px;">Cancelar</button>
        </form>
    </div>
</div>

<style>
    /* Contenedor centralizado */
    .contenedor-principal {
        display: flex;
        justify-content: center;
        margin-top: 50px;
    }

    /* El estilo de la "tarjeta" del formulario */
    .card-formulario {
        background: #fff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        width: 100%;
        max-width: 400px;
    }

    /* Campos de entrada */
    .campo {
        margin-bottom: 15px;
    }

    .campo input {
        width: 100%;
        padding: 10px;
        margin-top: 5px;
        border: 2px solid #002868; /* Azul Boca */
        border-radius: 5px;
        box-sizing: border-box;
    }

    /* Botón estilo Boca */
    .btn-azul-boca {
        width: 100%;
        background-color: #002868; /* Azul */
        color: #FDB913; /* Amarillo */
        font-weight: bold;
        padding: 12px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: 0.3s;
    }

    .btn-azul-boca:hover {
        background-color: #FDB913; /* Amarillo */
        color: #002868; /* Azul */
    }
</style>

<!-- Script para manejar la lógica de login, modal y contraseñas -->
<script>
    // Función para alternar la visibilidad de la contraseña
    function togglePassword(idInput, idIcon) {
        const input = document.getElementById(idInput);
        const icon = document.getElementById(idIcon);
        
        if (input.type === "password") {
            input.type = "text";
            icon.textContent = "👁️"; 
        } else {
            input.type = "password";
            icon.textContent = "🔒"; 
        }
    }

    // Funciones para abrir y cerrar el modal de recuperación
    function abrirModalRecuperar(e) {
        e.preventDefault();
        document.getElementById('modalRecuperar').style.display = 'flex';
    }

    function cerrarModalRecuperar() {
        document.getElementById('modalRecuperar').style.display = 'none';
    }

    // Lógica para enviar la nueva contraseña al servidor
    document.getElementById('formRecuperar').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const email = document.getElementById('emailRecuperar').value;
        const password = document.getElementById('passwordNueva').value;

        try {
            const response = await fetch('/recuperar-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });

            const data = await response.json();

            if (data.success) {
                // 1. Cerramos el modal y reseteamos el formulario PRIMERO
                cerrarModalRecuperar();
                document.getElementById('formRecuperar').reset();

                // 2. Mostramos el SweetAlert limpio para que se vea en primer plano
                Swal.fire({
                    icon: 'success',
                    title: '¡Contraseña actualizada!',
                    text: data.message,
                    confirmButtonColor: '#002868'
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.message || 'No se pudo actualizar la contraseña',
                    confirmButtonColor: '#002868'
                });
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error de servidor',
                text: 'Ocurrió un error al procesar la solicitud.',
                confirmButtonColor: '#002868'
            });
        }
    });

    // Lógica de inicio de sesión
    document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault(); // Evita el envío tradicional

        const email = document.getElementById('email').value;
        const password = document.getElementById('passwordLogin').value;

        try {
            const response = await fetch('/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });

            const data = await response.json();

            if (data.success) {
                // Validación específica si entra al panel de administración o rutas de admin
                if (data.redirect && (data.redirect.includes('admin') || data.redirect.includes('panel'))) {
                    Swal.fire({
                        icon: 'success',
                        title: '¡Acceso concedido!',
                        text: 'Bienvenido al panel de administración.',
                        timer: 1500,
                        showConfirmButton: false,
                        confirmButtonColor: '#002868'
                    }).then(() => {
                        window.location.href = data.redirect;
                    });
                } else {
                    window.location.href = data.redirect;
                }
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.message || 'Credenciales incorrectas',
                    confirmButtonColor: '#002868',
                    background: '#fff',
                    color: '#002868'
                });
            }
        } catch (error) {
            console.error('Error en la petición:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error de servidor',
                text: 'No se pudo conectar con el servidor.',
                confirmButtonColor: '#002868'
            });
        }
    });
</script>

<% if (typeof mensaje !== 'undefined' && mensaje !== null) { %>
    <script>
        Swal.fire({
            icon: 'success',
            title: '¡Bienvenido!',
            text: '<%= mensaje %>',
            confirmButtonColor: '#002868'
        });
    </script>
<% } %>