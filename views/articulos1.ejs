<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Artesanias Nativas</title>
    <link rel="stylesheet" href="../css/estilo3.css">
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <header>
        <div class="auth-buttons">
            <% if (usuario) { %>
                <span class="usuario-nombre">Hola, <%= usuario.nombre %>!</span>
                <a href="/logout" class="btn-auth">Cerrar Sesión</a>
            <% } else { %>
                <a href="/login" class="btn-auth">Iniciar Sesión</a>
                <a href="/registro" class="btn-auth">Registrarse</a>
            <% } %>
        </div>
        <div class="contenedor">
            <div class="wrapper"><img id="imagen1" src="../imagen/logo.png" class="img-1" alt=" "></div>
            <div class="text">
                <h1>ARTESANIAS NATIVAS</h1>
                <h2>Productos de Pueblos Originarios</h2>
            </div>
        </div>
        <nav>
            <ul>
                <div style="display: inline-flex;">
                <li><h1><a href="../">Inicio</a></h1></li>
                <li><h1><a href="../resumen">Resumen</a></h1></li>
                <li><h1><a href="../articulos">Productos</a></h1></li>
                <li><h1><a href="../contacto">Contacto</a></h1></li>
                <li><h1><a href="../autores">Autores</a></h1></li>
                </div>
            </ul>
        </nav>
    </header>

    <main class="layout-principal">
        <section>
            <h2>Productos</h2>
            <div class="contenedor1">
                <div class="producto-card" data-nombre="Figura de madera" data-precio="15000" data-desc="Figura de madera especial para adorno. Tamaño aproximado 10 cm.">
                    <img src="../imagen/artesania4.jpg" class="clickable-img" alt="">
                    <h3>Figura de madera</h3>
                    <p class="precio">$15.000</p>
                    <button class="btn-agregar">Añadir al carrito</button>
                </div>
                <div class="producto-card" data-nombre="Figuras de barro" data-precio="6000" data-desc="Lindas figuras de frutas hechas de barro.">
                    <img src="../imagen/artesania5.jpg" class="clickable-img" alt="">
                    <h3>Figuras de frutas hechas de barro.</h3>
                    <p class="precio">$6.000</p>
                    <button class="btn-agregar">Añadir al carrito</button>
                </div>
            </div>

            <div class="contenedor2">
                <div class="producto-card" data-nombre="Llamita de barro" data-precio="6000" data-desc="Llamita de barro especial para adorno andino y plantas.">
                    <img src="../imagen/artesania6.jpg" class="clickable-img" alt="">
                    <h3>Llamita de barro</h3>
                    <p class="precio">$6.000</p>
                    <button class="btn-agregar">Añadir al carrito</button>
                </div>
                <div class="producto-card" data-nombre="Porta Tazas" data-precio="5000" data-desc="Porta tazas de hilo para adorno.">
                    <img src="../imagen/artesania7.jpg" class="clickable-img" alt="">
                    <h3>Porta Tazas</h3>
                    <p class="precio">$5.000</p>
                    <button class="btn-agregar">Añadir al carrito</button>
                </div>
            </div>

            <div class="contenedor3">
                <div class="producto-card" data-nombre="Ollita de hilo" data-precio="10000" data-desc="Ollita hecha de hilo para guardar pertenencias.">
                    <img src="../imagen/artesania8.jpg" class="clickable-img" alt="">
                    <h3>Ollita de hilo</h3>
                    <p class="precio">$10.000</p>
                    <button class="btn-agregar">Añadir al carrito</button>
                </div>
                <div class="producto-card" data-nombre="Atrapasueños" data-precio="5000" data-desc="Atrapasueños de hilo para colgar.">
                    <img src="../imagen/artesania9.jpg" class="clickable-img" alt="">
                    <h3>Atrapasueños</h3>
                    <p class="precio">$5.000</p>
                    <button class="btn-agregar">Añadir al carrito</button>
                </div>
            </div>
        </section>

        <% if (usuario) { %>
        <aside id="carrito-tarjeta" class="carrito-sticky">
            <h2 class="titulo-carrito-adorno">Tu Carrito</h2>
            <div id="lista-carrito"></div>
            <hr>
            <div class="total-container" style="display: flex; justify-content: space-between; align-items: center; font-weight: bold; font-size: 1.2rem; margin: 15px 0; color: #000;">
                <span>Total:</span>
                <span>$<span id="total-carrito">0</span></span>
            </div>
            <button class="btn-carrito btn-finalizar" onclick="finalizarCompra()">Finalizar Compra</button>
            <a href="/historial" class="btn-carrito btn-historial">Ver Historial de Compras</a>
        </aside>
        <% } %>
    </main>

    <div id="modal-producto" class="modal">
        <div class="modal-contenido">
            <img id="modal-img" src="" alt="Producto">
            <h2 id="modal-titulo"></h2>
            <p id="modal-precio" class="precio"></p>
            <p id="modal-desc" style="margin: 15px 0; color: #555;"></p>
            <div style="display: flex; gap: 10px; justify-content: center; margin-top: 20px;">
                <button onclick="cerrarModal()" style="background:#7f8c8d; border:none; padding:10px; border-radius:10px; color:white; cursor:pointer;">Volver al Catálogo</button>
                <button id="modal-btn-agregar" onclick="agregarDesdeModal()" style="background:#28a745; border:none; padding:10px; border-radius:10px; color:white; cursor:pointer;">Agregar al Carrito</button>
            </div>
        </div>
    </div>

    <script>
        const usuarioActual = "<%= usuario ? usuario.nombre : 'invitado' %>";
        const usuarioGuardado = localStorage.getItem('usuarioLogueado');

        if (usuarioGuardado !== usuarioActual) {
            localStorage.removeItem('carrito');
            localStorage.setItem('usuarioLogueado', usuarioActual);
            var carrito = [];
        } else {
            var carrito = JSON.parse(localStorage.getItem('carrito')) || [];
        }

        let productoSeleccionado = null;

        renderCarrito();

        function renderCarrito() {
            const lista = document.getElementById('lista-carrito');
            const totalDisplay = document.getElementById('total-carrito');
            if(!lista) return;
            
            lista.innerHTML = '';
            let total = 0;

            const carritoAgrupado = carrito.reduce((acc, item) => {
                const found = acc.find(p => p.nombre === item.nombre);
                if (found) { found.cantidad++; } else { acc.push({ ...item, cantidad: 1 }); }
                return acc;
            }, []);

            carritoAgrupado.forEach((item) => {
                total += (item.precio * item.cantidad);
                lista.innerHTML += `
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 1px solid #eee; padding-bottom: 5px;">
                        <div>
                            <div style="font-weight: bold; color: #333;">${item.nombre}</div>
                            <div style="font-size: 0.85rem; color: #666;">$${item.precio.toLocaleString()} x ${item.cantidad}</div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span style="font-weight: bold;">$${(item.precio * item.cantidad).toLocaleString()}</span>
                            <span style="color: red; cursor: pointer; font-size: 1.2rem; font-weight: bold;" onclick="eliminarProducto('${item.nombre}')">X</span>
                        </div>
                    </div>`;
            });
            totalDisplay.textContent = total.toLocaleString();
            localStorage.setItem('carrito', JSON.stringify(carrito));
        }

        function eliminarProducto(nombre) {
            carrito = carrito.filter(p => p.nombre !== nombre);
            renderCarrito();
        }

        function agregarProducto(nombre, precio) {
            carrito.push({ nombre, precio });
            renderCarrito();
        }

        async function finalizarCompra() {
            if (carrito.length === 0) {
                Swal.fire('Atención', 'Tu carrito está vacío', 'warning');
                return;
            }

            const carritoParaEnviar = carrito.reduce((acc, item) => {
                const found = acc.find(p => p.nombre === item.nombre);
                if (found) {
                    found.cantidad++;
                } else {
                    acc.push({ ...item, cantidad: 1 });
                }
                return acc;
            }, []);

            const total = carrito.reduce((sum, p) => sum + p.precio, 0);

            const result = await Swal.fire({
                title: '¿Confirmar compra?',
                text: `Total a pagar: $${total.toLocaleString()}`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#7f8c8d',
                confirmButtonText: 'Sí, confirmar'
            });

            if (result.isConfirmed) {
                const response = await fetch('/finalizar-compra', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ total, carrito: carritoParaEnviar })
                });

                if (response.ok) {
                    Swal.fire('¡Éxito!', 'Compra realizada con éxito', 'success').then(() => {
                        carrito = [];
                        localStorage.removeItem('carrito');
                        renderCarrito();
                    });
                } else {
                    Swal.fire('Error', 'No se pudo procesar la compra', 'error');
                }
            }
        }

        document.querySelectorAll('.btn-agregar').forEach(btn => {
            btn.addEventListener('click', function() {
                const prod = this.closest('.producto-card');
                agregarProducto(prod.getAttribute('data-nombre'), parseInt(prod.getAttribute('data-precio')));
            });
        });

        const modal = document.getElementById('modal-producto');
        document.querySelectorAll('.clickable-img').forEach(img => {
            img.addEventListener('click', function() {
                const card = this.closest('.producto-card');
                productoSeleccionado = { nombre: card.getAttribute('data-nombre'), precio: parseInt(card.getAttribute('data-precio')) };
                document.getElementById('modal-img').src = this.src;
                document.getElementById('modal-titulo').textContent = productoSeleccionado.nombre;
                document.getElementById('modal-precio').textContent = card.querySelector('.precio').textContent;
                document.getElementById('modal-desc').textContent = card.getAttribute('data-desc');
                modal.style.display = 'flex';
            });
        });

        function agregarDesdeModal() {
            if (productoSeleccionado) {
                agregarProducto(productoSeleccionado.nombre, productoSeleccionado.precio);
                cerrarModal();
            }
        }

        function cerrarModal() { modal.style.display = 'none'; }
    </script>

    <style>
        .usuario-nombre {
            background-color: #8b6e4e;
            color: white; 
            padding: 12px 24px; 
            border-radius: 25px; 
            font-weight: bold; 
            display: inline-block; 
        }
        .auth-buttons { 
            position: absolute; 
            top: 15px; 
            right: 20px; 
            display: flex; 
            gap: 15px; 
            align-items: center; 
        }
        .btn-auth { 
            background-color: #8b6e4e; 
            color: white; 
            padding: 12px 24px; 
            border-radius: 25px; 
            text-decoration: none; 
            font-weight: bold; 
            display: inline-block; 
            transition: all 0.3s ease;
        }
        .btn-auth:hover { 
            background-color: #ffffff;
            color: #8b6e4e !important;
            border-color: #8b6e4e;
            transform: translateY(-3px); 
            box-shadow: 0 6px 12px rgba(0,0,0,0.2);
        }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); justify-content: center; align-items: center; z-index: 1000; }
        .modal-contenido { background: white; padding: 20px; border-radius: 20px; width: 90%; max-width: 500px; text-align: center; }
        .clickable-img { cursor: pointer; transition: transform 0.3s ease; }
        .clickable-img:hover { transform: scale(1.05); }
        .layout-principal { display: grid; grid-template-columns: 1fr 350px; gap: 30px; padding: 40px; max-width: 1200px; margin: auto; align-items: start; }
        .producto-card { background: #af954cb0; border: 1px solid #ddd; border-radius: 25px; padding: 20px; text-align: center; margin-bottom: 20px; }
        .producto-card img { width: 100%; height: 200px; object-fit: cover; border-radius: 15px; }
        .carrito-sticky { background: #fff; padding: 20px; border-radius: 15px; position: sticky; top: 20px; border: 1px solid #ddd; box-shadow: 0 4px 8px rgba(0,0,0,0.05); }
        .btn-finalizar { background-color: #28a745; color: white; padding: 15px; border: none; border-radius: 10px; width: 100%; cursor: pointer; font-weight: bold; font-size: 1rem; transition: background-color 0.2s; }
        .btn-finalizar:hover { background-color: #218838; }
        .btn-agregar { background-color: #8b6e4e; color: white; border: none; padding: 12px 20px; border-radius: 10px; width: 100%; cursor: pointer; font-weight: bold; transition: all 0.3s ease; }
        .btn-agregar:hover { background-color: #a6845d; transform: scale(1.05); }
        nav ul li h1 a { text-decoration: none; color: white; transition: all 0.3s ease; display: inline-block; }
        nav ul li h1 a:hover { color: #f1c40f; transform: scale(1.1); }
        .titulo-carrito-adorno { background-color: #cfbc8c; color: white; text-align: center; padding: 10px; font-family: 'Georgia', serif; font-style: italic; font-size: 2rem; border-radius: 4px; margin-top: 0; margin-bottom: 20px; }
        .modal-contenido img { width: 100%; height: 300px; object-fit: contain; background-color: #f9f9f9; border-radius: 30px; }
        .btn-carrito { display: block !important; width: 100% !important; box-sizing: border-box !important; margin: 5px 0 0 0 !important; padding: 15px 0 !important; text-align: center !important; border: none !important; border-radius: 5px !important; color: white !important; font-size: 16px !important; font-weight: bold !important; text-decoration: none !important; cursor: pointer; transition: transform 0.2s, background-color 0.2s; }
        .btn-finalizar { background-color: #27ae60; }
        .btn-historial { background-color: #27ae60; }
        .btn-carrito:hover { transform: scale(1.02); }
        .btn-estilo-compra { display: inline-block; background-color: #27ae60; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; font-weight: bold; transition: transform 0.3s ease, background-color 0.3s ease; }
        .btn-estilo-compra:hover { background-color: #219150; transform: scale(1.05); }
        .btn-estilo-compra:active { transform: scale(0.98); }
    </style>
    <footer>
        <a href="https://www.facebook.com/profile.php?id=61568974913151" target="_blank">
            <img src="../imagen/2021_Facebook_icon.svg.png" alt="logo del sitio">
        </a>
        <a href="https://www.instagram.com/ventas_artesanales_online/" target="_blank">
            <img src="../imagen/instagram.jpg" class="instagram" alt="logo del sitio">
        </a>
        <p class="pie">&copy; 2024 Artesanias Nativas. Todos los derechos reservados.</p>
        
    </footer>
</body>
</html>