<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Artesanias Nativas</title>
    <link rel="stylesheet" href="../css/autores.css">
    <style>
        html {
    background-color: beige; 
}

body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: hsla(0, 93%, 50%, 0.863); 
    background: url(../imagen/logo1.png);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center; 
}


.contenedor {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: center;
}

.wrapper {
    grid-column: 1;
    width: 10%;
    height: auto;
    margin-left: 10px;
}

.text {
    grid-column: 2;
    width: 100%;
    margin-top: -10px;
    margin-left: -500px;
    padding-top: 0;
    text-align: center;
}

h1 {
    color: white;
    margin-left: 0%;
}
h2{
    color: white;
    background-color: #af954cb0;
}
.img-1 {
    margin-top: 10px;
    margin-left: 5px; 
    border-radius: 25px;   
    width: 125px;
     
}

header {
    height: auto;
    background-color: #af954cb0;
    color: white;
    font-family: 'Times New Roman', Times, serif, Helvetica, sans-serif;
    padding: 5px 0;
    text-align: center;
}


nav ul {
    list-style-type: none;
    padding: 0%;
}

nav ul li {
    display: inline;
    margin: 0 25px;
}

nav ul li a {
    color: white;
    text-decoration: none;
    font-family: Cambria, Cochin, Georgia, Times, 'Times New Roman', serif;
    margin-top: -10px;
    padding-top: 0;
    position: relative;
    top: -30px;
}

nav ul li a.activo {
    text-decoration: underline;
    font-weight: bold;
    color: #ffd700; 
}


main {
    padding: 20px;
    text-align: center;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 25px;
    
    border-radius: 10px;
    max-width: 1000px;
    margin: 20px auto;
}

section {
    max-width: 900px;
    margin: auto;
}


.miembro-card {
     background: #af954cb0;
    border-radius: 25px;
    margin: 20px 0;
    padding: 25px;
    text-align: center;
    box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.2);
}

.miembro-card h3 {
    color: rgb(255, 255, 255);
    font-size: 1.8em;
    margin-bottom: 15px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.5);
    padding-bottom: 10px;
    background-color: #af954cb0;
}

.miembro-card p {
    color: rgb(255, 255, 255);
    font-size: 0.9em;
    margin-bottom: 15px;
    background-color: #af954cb0;
}


.miembro-img {
    width: 40%;
    background: #af954cb0;
    border: 1px solid #ddd;
    border-radius: 25px;
    margin: 10px 0;
    padding: 5px;
    text-align: center;
}

.contacto-info {
    font-style: italic;
    font-weight: bold;
    font-size: 1em;
    padding-top: 10px;
}


footer {
    background: #af954cb0;
    color: white;
    text-align: center;
    padding: 10px 0;
    position: relative;
    bottom: 0;
    width: 100%;
    height: 100px;
}
.pie{
    text-align: center;
    color: white;
    font-size: 20px;
}
.pf{
    color: rgb(252, 0, 0);
    text-align: center;
}
a{
    display: inline;
    margin: 0 25px;
    text-decoration: none;
}
a img{
    max-width: 2.5%;
    height: auto;
}
.instagram{
    border-radius: 20px;
}
/* Estilo base de los enlaces del menú */
nav a {
    color: #000000; /* Color actual del texto */
    text-decoration: none;
    padding: 10px 15px;
    transition: all 0.3s ease-in-out; /* ¡Aquí está la magia! */
    position: relative;
}

/* Estilo al pasar el mouse (hover) */
nav a:hover {
    color: #020202; /* Un color dorado para resaltar */
    transform: scale(1.1); /* Un pequeño efecto de zoom */
    background-color: rgba(255, 255, 255, 0.1); /* Un fondo sutil al hover */
    border-radius: 5px;
}

/* Opcional: Una línea subrayada animada */
nav a::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 0;
    left: 50%;
    background-color: #f1c40f;
    transition: all 0.3s ease;
}

nav a:hover::after {
    width: 100%;
    left: 0;
}
/* Contenedor de botones (Arriba a la derecha) */
.auth-buttons {
    position: absolute;
    top: 15px;
    right: 20px;
    display: flex;
    gap: 15px;
    align-items: center;
    z-index: 9999; /* Asegura que siempre estén por encima de todo */
}

/* Estilo base de los botones */
.btn-auth {
    background-color: #8b6e4e; 
    color: white !important;
    padding: 10px 20px;
    border-radius: 25px; 
    text-decoration: none !important;
    font-size: 0.9rem;
    font-weight: bold;
    transition: all 0.4s ease; 
    border: 2px solid transparent;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    display: inline-block;
}

/* Animación al pasar el mouse */
.btn-auth:hover {
    background-color: #ffffff;
    color: #8b6e4e !important;
    border-color: #8b6e4e;
    transform: translateY(-3px); 
    box-shadow: 0 6px 12px rgba(0,0,0,0.2);
}

/* Estilo para el texto del usuario */
.usuario-nombre {
    color: white;
    font-size: 0.9rem;
    margin-right: 10px;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
}
/* Estilo base (blanco) */
nav a {
    color: #ffffff; 
    /* ... */
}

/* Estilo al pasar el mouse (hover) */
nav a:hover {
    color: #ffffff; /* <--- AQUÍ ESTÁ EL SECRETO */
    transform: scale(1.15); 
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 8px;
}
nav ul li h1 a { text-decoration: none; color: white; transition: all 0.3s ease; display: inline-block; outline: none; }
        nav ul li h1 a:hover { color: #f1c40f; transform: scale(1.1); text-shadow: 0 0 5px rgba(255,255,255,0.5); outline: none; }
nav ul li h1 a:focus {
    outline: none;
    background-color: transparent;
}
.usuario-nombre {
    background-color: #8b6e4e; /* Mismo color de fondo que los botones */
    color: white;             /* Texto blanco para contrastar */
    padding: 12px 24px;       /* Mismo espacio interno que los botones */
    border-radius: 25px;      /* Bordes redondeados */
    font-weight: bold;        /* Texto en negrita */
    display: inline-block;    /* Para que respete el padding */
}
    </style>
</head>
<body>
    <header>
         <div class="auth-buttons">
            <% if (usuario) { %>
                <span class="usuario-nombre">Hola, <%= usuario.nombre %>!</span>
                <a href="/logout" class="btn-auth">Cerrar Sesión</a>
            <% } else { %>
                <a href="/login" class="btn-auth">Iniciar Sesión</a>
                <a href="/registro" class="btn-auth">Registrarse</a>
            <% } %>
        </div>
        <div class="contenedor">
        <div class="wrapper">
            <img id="imagen1" src="../imagen/logo.png" class="img-1" alt=" ">
        </div>
            <div class="text">
                <h1>ARTESANIAS NATIVAS</h1>
                <h2>Productos de Pueblos Originarios</h2>
            </div>
            
        </div>
         <nav>
            <ul>
                <div style="display: inline-flex;">
                <li><h1><a href="../">Inicio</a></h1></li>
                <li><h1><a href="../resumen">Resumen</a></h1></li>
                 <li><h1><a href="../articulos">Productos</a></h1></li>
                <li><h1><a href="../contacto">Contacto</a></h1></li>
                <li><h1><a href="../autores">Autores</a></h1></li>
                </div>
                </div>
            </ul>
         
        </nav> 
    </header>
    <main>
        <section>
            <div class="miembro-card">
                <h3>INTEGRANTES:</h3><br>
                <h2>Perales Fernandez, Carlos Daniel</h2><br>
                <img src="../imagen/autor.jpg" alt="Retrato de Carlos Perales" class="miembro-img">
                <h2>Ovando Rodrigo</h2><br>
                <img src="../imagen/rodrigo.jpg" alt="Retrato de Ovando Rodrigo" class="miembro-img">
                <h2>Diseañdor de Back-End y Front-End</h2>
                </p>
                
            </div>

            
        </section>
    </main>
<footer>
        <a href="https://www.facebook.com/profile.php?id=61568974913151" target="_blank">
            <img src="../imagen/2021_Facebook_icon.svg.png" alt="logo del sitio">
        </a>
        <a href="https://www.instagram.com/ventas_artesanales_online/" target="_blank">
            <img src="../imagen/instagram.jpg" class="instagram" alt="logo del sitio">
        </a>
        <p class="pie">&copy; 2024 Artesanias Nativas. Todos los derechos reservados.</p>
        
    </footer>
</body>
</html>