.instagram{
    border-radius: 20px;
}
/* Estilo base de los enlaces del menú */
nav a {
    color: #000000; /* Color actual del texto */
    text-decoration: none;
    padding: 10px 15px;
    transition: all 0.3s ease-in-out; /* ¡Aquí está la magia! */
    position: relative;
}

/* Estilo al pasar el mouse (hover) */
nav a:hover {
    color: #020202; /* Un color dorado para resaltar */
    transform: scale(1.1); /* Un pequeño efecto de zoom */
    background-color: rgba(255, 255, 255, 0.1); /* Un fondo sutil al hover */
    border-radius: 5px;
}

/* Opcional: Una línea subrayada animada */
nav a::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 0;
    left: 50%;
    background-color: #725d08;
    transition: all 0.3s ease;
}

nav a:hover::after {
    width: 100%;
    left: 0;
}
/* Contenedor de botones (Arriba a la derecha) */
.auth-buttons {
    position: absolute;
    top: 15px;
    right: 20px;
    display: flex;
    gap: 15px;
    align-items: center;
    z-index: 9999; /* Asegura que siempre estén por encima de todo */
}

/* Estilo base de los botones */
.btn-auth {
    background-color: #8b6e4e; 
    color: white !important;
    padding: 10px 20px;
    border-radius: 25px; 
    text-decoration: none !important;
    font-size: 0.9rem;
    font-weight: bold;
    transition: all 0.4s ease; 
    border: 2px solid transparent;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    display: inline-block;
}

/* Animación al pasar el mouse */
.btn-auth:hover {
    background-color: #ffffff;
    color: #8b6e4e !important;
    border-color: #8b6e4e;
    transform: translateY(-3px); 
    box-shadow: 0 6px 12px rgba(0,0,0,0.2);
}

/* Estilo para el texto del usuario */
.usuario-nombre {
    background-color: #8b6e4e; /* Mismo color de fondo que los botones */
    color: white;             /* Texto blanco para contrastar */
    padding: 12px 24px;       /* Mismo espacio interno que los botones */
    border-radius: 25px;      /* Bordes redondeados */
    font-weight: bold;        /* Texto en negrita */
    display: inline-block;    /* Para que respete el padding */
}
/* Estilo base (blanco) */
nav a {
    color: #ffffff; 
    /* ... */
}

/* Estilo al pasar el mouse (hover) */
nav a:hover {
    color: #ffffff; /* <--- AQUÍ ESTÁ EL SECRETO */
    transform: scale(1.15); 
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 8px;
}
/* Aseguramos que la navegación no pierda su animación */
nav ul li h1 a {
    text-decoration: none;
    color: white; /* O el color que uses para tus enlaces */
    transition: all 0.3s ease; /* Transición suave para cualquier cambio */
    display: inline-block; /* Importante para que el transform funcione bien */
}

/* Animación al pasar el cursor por el menú */
nav ul li h1 a:hover {
    color: #f1c40f; /* Cambia al color que prefieras al pasar el cursor */
    transform: scale(1.1); /* Efecto de crecimiento suave */
    text-shadow: 0 0 5px rgba(255,255,255,0.5); /* Un pequeño brillo al pasar el mouse */
    outline: none;
}
