<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Artesanias Nativas</title>
    <!-- SweetAlert2 para las alertas -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="../css/estilo2.css">
    
    <style>
    /* Solo el estilo del contenedor nuevo, nada más */
    .mi-formulario-contacto {
        max-width: 450px;
        margin: 50px auto;
        padding: 30px;
        background-color: #af954cb0;
        border: 2px solid black;
        border-radius: 30px;
    }
    nav ul li h1 a { text-decoration: none; color: white; transition: all 0.3s ease; display: inline-block; outline: none; }
    nav ul li h1 a:hover { color: #f1c40f; transform: scale(1.1); text-shadow: 0 0 5px rgba(255,255,255,0.5); outline: none; }
    .mi-formulario-contacto h2 { color: white; text-align: center; margin-bottom: 20px; }
    #formularioContacto { display: flex; flex-direction: column; gap: 20px; }
    .mi-formulario-contacto input, .mi-formulario-contacto textarea { 
        width: 100%; padding: 10px; border: 2px solid black; border-radius: 20px; box-sizing: border-box; 
    }
    .mi-formulario-contacto button { 
        margin-top: 10px; width: 150px; margin-left: auto; margin-right: auto; cursor: pointer;
    }
    .usuario-nombre {
            background-color: #8b6e4e;
            color: white; 
            padding: 12px 24px; 
            border-radius: 25px; 
            font-weight: bold; 
            display: inline-block; 
        }
        .auth-buttons { 
            position: absolute; 
            top: 15px; 
            right: 20px; 
            display: flex; 
            gap: 15px; 
            align-items: center; 
        }
        .btn-auth { 
            background-color: #8b6e4e; 
            color: white; 
            padding: 12px 24px; 
            border-radius: 25px; 
            text-decoration: none; 
            font-weight: bold; 
            display: inline-block; 
            transition: all 0.3s ease;
        }
        .btn-auth:hover { 
            background-color: #ffffff;
            color: #8b6e4e !important;
            border-color: #8b6e4e;
            transform: translateY(-3px); 
            box-shadow: 0 6px 12px rgba(0,0,0,0.2);
        }
</style>
</head>
<body>
    <header>
         <div class="auth-buttons">
            <% if (usuario) { %>
                <span class="usuario-nombre">Hola, <%= usuario.nombre %>!</span>
                <a href="/logout" class="btn-auth">Cerrar Sesión</a>
            <% } else { %>
                <a href="/login" class="btn-auth">Iniciar Sesión</a>
                <a href="/registro" class="btn-auth">Registrarse</a>
            <% } %>
         </div>
        <div class="contenedor">
        <div class="wrapper">
            <img id="imagen1" src="../imagen/logo.png" class="img-1" alt=" ">
        </div>
            <div class="text">
                <h1>ARTESANIAS NATIVAS</h1>
                <h2>Productos de Pueblos Originarios</h2>
            </div>
        </div>
         <nav>
            <ul>
                <div style="display: inline-flex;">
                <li><h1><a href="../">Inicio</a></h1></li>
                <li><h1><a href="../resumen">Resumen</a></h1></li>
                 <li><h1><a href="../articulos">Productos</a></h1></li>
                <li><h1><a href="../contacto">Contacto</a></h1></li>
                <li><h1><a href="../autores">Autores</a></h1></li>
                </div>
            </ul>
        </nav>
    </header>

    <!-- Contenedor del formulario con un ID propio para no afectar el resto -->
    <div class="mi-formulario-contacto">
        <h2>Contacto</h2>
        <form id="formularioContacto" enctype="multipart/form-data">
            <input type="text" name="nombre" placeholder="Tu Nombre" required>
            <input type="email" name="correo" placeholder="Tu Correo" required>
            <textarea name="mensaje" rows="4" placeholder="Tu mensaje..." required></textarea>
            
            <div class="selector-archivo">
                <label>Subir imagen:</label>
                <input type="file" name="imagen" accept="image/*">
            </div>
            
            <button type="submit">Enviar</button>
        </form>
    </div>

    <!-- Script para enviar datos sin recargar la página -->
    <script>
        document.getElementById('formularioContacto').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);

            const res = await fetch('/enviar-mensaje', {
                method: 'POST',
                body: formData
            });

            if (res.ok) {
                Swal.fire('¡Enviado!', 'Gracias por tu aporte.', 'success');
                e.target.reset();
            } else {
                Swal.fire('Error', 'Hubo un problema.', 'error');
            }
        });
    </script>

    <footer>
        <a href="https://www.facebook.com/profile.php?id=61568974913151" target="_blank">
            <img src="../imagen/2021_Facebook_icon.svg.png" alt="logo del sitio">
        </a>
        <a href="https://www.instagram.com/ventas_artesanales_online/" target="_blank">
            <img src="../imagen/instagram.jpg" class="instagram" alt="logo del sitio">
        </a>
        <p class="pie">&copy; 2024 Artesanias Nativas. Todos los derechos reservados. </p>
    </footer>
</body>
</html>